# Optional local runtime settings. Copy to .env for your own machine.
# Do not commit .env.

AMZ_DASHBOARD_DATA_DIR=
AMZ_INVENTORY_PERSON_DEPARTMENT=

# Optional ERP auto-update settings. Leave blank if you only import Excel manually.
AMZ_ERP_LOGIN_URL=
AMZ_ERP_TARGET_URL=
AMZ_ERP_API_BASE_URL=
AMZ_ERP_STOCK_EXPORT_API=/api/stock/erp-stock/export
AMZ_ERP_TASK_LIST_API=/api/task/list?page=1&perPage=20

# Optional Selenium override.
AMZ_FORCE_CHROME=0
